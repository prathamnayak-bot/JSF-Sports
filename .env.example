# Copy this file to .env (same folder) and fill in your values. .env is git-ignored - never commit keys.

# LLM: any OpenAI-compatible API. Groq is free: create a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# OpenAI instead:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Local Ollama instead (no key needed, run `ollama pull qwen2.5-coder:3b` first):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:3b

# Database (these match docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/cricket?reWriteBatchedInserts=true
DB_USERNAME=cricket
DB_PASSWORD=cricket
# Port 5432 already used on your machine? Run the Docker database on another port (and update DB_URL):
# POSTGRES_PORT=5433

# AI chat queries run as a read-only database user (created by docker/postgres/01-readonly-user.sql).
# Leave unset with the H2 profile.
CHAT_DB_USERNAME=cricket_readonly
CHAT_DB_PASSWORD=cricket_readonly

# Daily Cricsheet sync (04:00 by default). Datasets: ipl, t20s, odis, bbl, psl, ...
# SYNC_ENABLED=true
# SYNC_DATASETS=ipl

# Fixtures (upcoming / recent matches): free key from https://cricketdata.org (100 calls/day; we use 2 per refresh)
CRICKETDATA_API_KEY=
# FIXTURES_SERIES=Indian Premier League
